---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div class="px-40 flex flex-1 justify-center py-5">
    <div class="layout-content-container flex flex-col max-w-[960px] flex-1">
      <div class="@container">
        <div class="@[480px]:p-4">
          <div
            class="flex min-h-[480px] flex-col gap-6 bg-cover bg-center bg-no-repeat @[480px]:gap-8 @[480px]:rounded-lg items-start justify-end px-4 pb-10 @[480px]:px-10"
            style='background-image: linear-gradient(rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.4) 100%), url("https://lh3.googleusercontent.com/aida-public/AB6AXuB4DKypFuBHvh4lu9tJWS_h7J2QKDF98uf7ekQ8DaHizJub4xub_Luc0qKIXOJtawA1HFH85PEUNvntTK5DCcgGyBHpahOyFNOGH3VrTIbGSKMX6BkaiZlsH_7UDEdE4yDdVgC9C5a-U6qC5aF0twBG-Q0ndw6eeFe_AS9YEFRKDq7hkr4KaUBRBO-qqY8WreoPBK7UeVNTZjbPGRVAIi72pIgDjQ1FlgNHwNxyo0m5lJFZznRsJX_xENTbISO5SN6s3Zv3QZmGqAU");'
          >
            <div class="flex flex-col gap-2 text-left">
              <h1
                class="text-white text-4xl font-black leading-tight tracking-[-0.033em] @[480px]:text-5xl @[480px]:font-black @[480px]:leading-tight @[480px]:tracking-[-0.033em]"
              >
                33-Day Express.js Crash Course
              </h1>
              <h2 class="text-white text-sm font-normal leading-normal @[480px]:text-base @[480px]:font-normal @[480px]:leading-normal">
                Master the fundamentals of Express.js in just 33 days. This comprehensive course covers everything from basic routing to advanced topics like middleware,
                authentication, validation, and security. Get hands-on experience with real-world projects and build a solid foundation for your web development career.
              </h2>
            </div>
            <a href="/weeks/1">
              <button
                class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-lg h-10 px-4 @[480px]:h-12 @[480px]:px-5 bg-[#0d78f2] text-white text-sm font-bold leading-normal tracking-[0.015em] @[480px]:text-base @[480px]:font-bold @[480px]:leading-normal @[480px]:tracking-[0.015em]"
              >
                <span class="truncate">Start Course</span>
              </button>
            </a>
          </div>
        </div>
      </div>
      <h2 class="text-white text-[22px] font-bold leading-tight tracking-[-0.015em] px-4 pb-3 pt-5">Course Outline</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(158px,1fr))] gap-3 p-4">
        <a href="/weeks/1" class="flex flex-1 gap-3 rounded-lg border border-[#3b4754] bg-[#1b2127] p-4 items-center">
          <h2 class="text-white text-base font-bold leading-tight">Week 1</h2>
        </a>
        <a href="/weeks/2" class="flex flex-1 gap-3 rounded-lg border border-[#3b4754] bg-[#1b2127] p-4 items-center">
          <h2 class="text-white text-base font-bold leading-tight">Week 2</h2>
        </a>
        <a href="/weeks/3" class="flex flex-1 gap-3 rounded-lg border border-[#3b4754] bg-[#1b2127] p-4 items-center">
          <h2 class="text-white text-base font-bold leading-tight">Week 3</h2>
        </a>
        <a href="/weeks/4" class="flex flex-1 gap-3 rounded-lg border border-[#3b4754] bg-[#1b2127] p-4 items-center">
          <h2 class="text-white text-base font-bold leading-tight">Week 4</h2>
        </a>
        <a href="/weeks/5" class="flex flex-1 gap-3 rounded-lg border border-[#3b4754] bg-[#1b2127] p-4 items-center">
          <h2 class="text-white text-base font-bold leading-tight">Week 5</h2>
        </a>
      </div>
    </div>
  </div>
</Layout>